// StudyFlow — Prisma schema (SQLite)
//
// DATABASE PATH CONTRACT (Prisma 6.19, verified empirically — see
// docs/Tailwind-V4-Validation-Report.md methodology + tests/db-path.test.ts):
//   • A url HARDCODED in the schema resolves relative to THIS FILE (prisma/).
//   • A SHELL-provided env("DATABASE_URL") relative `file:` URL ALSO anchors
//     at this schema file → "file:../db/custom.db" = <repo>/db/custom.db.
//   • An env var loaded from an .env FILE by the CLI anchors at the CWD
//     instead — which is why the `db:*` npm scripts set DATABASE_URL inline
//     (shell-provided, schema-anchored) rather than relying on auto-loading.
//   • The RUNTIME (next dev / build / standalone) reads .env's DATABASE_URL
//     through src/lib/db.ts, whose db-path.ts module re-resolves relative
//     `file:` URLs against the repo that owns this schema — one file,
//     <repo>/db/custom.db, for every entry point.
// The db/ folder lives at the repo root, git-ignored (recreate with
// `bun run db:push && bun run db:seed`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String   @default("")
  avatarEmoji   String   @default("🎓")
  themeMode     String   @default("system") // light | dark | system
  accentColor   String   @default("violet") // violet|blue|green|orange|pink|red|teal
  emailVerified Boolean  @default(false) // S15: the login gate (ADR-013)
  // S17-A: the reference's Profile tab persists four study-profile fields on
  // its User entity (captured from the reference's own PUT body:
  // school_name / grade_level / study_goal_hours / notifications_enabled —
  // defaults match the reference's own defaults: empty school, empty grade,
  // 4h goal, notifications on). See docs/remediation-plan-session17.md.
  schoolName           String   @default("")
  gradeLevel           String   @default("") // "" | 6th–12th Grade | College Freshman…Senior | Graduate
  studyGoalHours       Int      @default(4)
  notificationsEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  subjects             Subject[]
  tasks                Task[]
  taskLists            TaskList[]
  assignments          Assignment[]
  exams                Exam[]
  events               Event[]
  timetableClass       TimetableClass[]
  notes                Note[]
  notebooks            Notebook[]
  decks                FlashcardDeck[]
  practiceTests        PracticeTest[]
  studyGroups          StudyGroup[]
  grades               Grade[]
  focusSessions        FocusSession[]
  folders              FileFolder[]
  files                FileItem[]
  chatMessages         AiChatMessage[]
  calcHistory          CalculatorHistoryEntry[]
  holidays             Holiday[]
  rumEvents            RumEvent[]
  verificationTokens   VerificationToken[]
  passwordResetTokens  PasswordResetToken[]
}

// S15 (ADR-013) — email verification + password reset. One-shot tokens:
// used/expired rows are deleted by the consuming route. No SMTP exists in
// this self-hosted app, so the routes surface the code/link to the actor
// directly (the documented trade-off — see docs/remediation-plan-session15.md).
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit zero-padded
  expiresAt DateTime // 15 minutes
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // 48-hex
  expiresAt DateTime // 30 minutes
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  teacher   String   @default("")
  room      String   @default("")
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  assignments    Assignment[]
  exams          Exam[]
  timetableClass TimetableClass[]
  decks          FlashcardDeck[]
  practiceTests  PracticeTest[]
  studyGroups    StudyGroup[]
  grades         Grade[]
  focusSessions  FocusSession[]
}

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
}

model Task {
  id         String    @id @default(cuid())
  userId     String
  title      String
  notes      String    @default("")
  completed  Boolean   @default(false)
  important  Boolean   @default(false)
  dueDate    DateTime?
  listId     String?
  subjectId  String?
  // S6-B — reference dialog fields (measured): priority colors the round
  // checkbox border (slate-300 none / red-400 high); repeat expands into
  // occurrences in the Tasks/MyDay windows; myDay drives the MyDay view.
  priority   String    @default("none") // none | low | medium | high
  repeat     String    @default("none") // none | daily | weekly | monthly
  myDay      Boolean   @default(false)
  subtasks   String    @default("[]") // JSON [{id,title,done}]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list    TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  subject Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, completed])
  @@index([userId, dueDate])
}

model Assignment {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String    @default("")
  subjectId   String?
  dueDate     DateTime?
  status      String    @default("active") // active | submitted | graded
  priority    String    @default("medium") // low | medium | high | urgent (S6-E)
  score       Float?
  maxScore    Float?
  // S6-E — the reference's assignment rows (measured): type pill +
  // interactive progress slider (0-100, gradient fill).
  type        String    @default("homework") // homework | essay | project | reading | worksheet | presentation | study | other
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Exam {
  id        String    @id @default(cuid())
  userId    String
  title     String
  subjectId String?
  date      DateTime
  endTime   DateTime?
  location  String    @default("")
  notes     String    @default("")
  status    String    @default("upcoming") // upcoming | done
  // S6-F — the reference's exam cards/dialog (measured): type footer pill,
  // "12:00 AM · 60 min" duration line, topics adder (JSON string array).
  type      String    @default("test") // test | quiz | midterm | final | oral | practical
  duration  Int       @default(60)
  topics    String    @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#8b5cf6")
  // S5-B2 — the reference dialog's fields: Location / Link, Repeat
  // (none|daily|weekly|monthly), Reminders (JSON minutes-before array).
  location    String   @default("")
  repeat      String   @default("none")
  reminders   String   @default("[]")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model TimetableClass {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  name      String
  dayOfWeek Int // 0 = Monday … 6 = Sunday (ISO weekday - 1)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  room      String   @default("")
  teacher   String   @default("")
  color     String   @default("#8b5cf6")
  // S5-J — the reference's "All Weeks / Week A / Week B" select:
  // alternating-week timetables.
  weekType  String   @default("ALL")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, dayOfWeek])
}

model Notebook {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  notebookId String?
  title      String   @default("Untitled")
  content    String   @default("")
  tags       String   @default("") // comma-separated
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
}

model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  color       String   @default("#8b5cf6") // S7-A: reference deck swatch (violet/blue/emerald/amber/red/pink)
  subjectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  cards   Flashcard[]
}

model Flashcard {
  id         String  @id @default(cuid())
  deckId     String
  front      String
  back       String
  difficulty String  @default("medium") // S7-A: reference card badge (easy/medium/hard)
  mastered   Boolean @default(false)
  order      Int     @default(0)
  createdAt DateTime @default(now())

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model PracticeTest {
  id              String    @id @default(cuid())
  userId          String
  title           String
  subjectId       String?
  date            DateTime?
  status          String    @default("created") // created | in_progress | completed
  score           Float?
  questions       String    @default("[]") // S7-B: JSON [{question,type}] (multiple_choice/true_false/short_answer)
  totalQuestions  Int       @default(0)
  correctCount    Int       @default(0)
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model StudyGroup {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  subjectId   String?
  color       String    @default("#8b5cf6")
  members     String    @default("[]") // JSON array [{name, email}]
  nextMeeting DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model Grade {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String?
  assessment String
  score      Float
  maxScore   Float    @default(100)
  weight     Float    @default(1)
  type       String   @default("assignment") // assignment | exam | quiz | project
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model FocusSession {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String?
  date            DateTime @default(now())
  durationMinutes Int
  mode            String   @default("focus") // focus | short_break | long_break
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model FileFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    FileItem[]
}

model FileItem {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  name      String
  mimeType  String   @default("application/octet-stream")
  size      Int      @default(0)
  data      String? // base64 payload for small files (<= 2 MiB), null for links
  url       String   @default("") // external link (link-files)
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder FileFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId, folderId])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CalculatorHistoryEntry {
  id         String   @id @default(cuid())
  userId     String
  expression String
  result     String
  mode       String   @default("basic") // basic | scientific | gpa | converter
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Holiday {
  id        String   @id @default(cuid())
  userId    String
  name      String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// S18 (ADR-016) — the RUM hook: one row per (sessionId, metric) report the
// authed beacon POSTs. UPSERT on the unique pair so the web-vitals
// final-value-wins semantics update in place (an LCP candidate re-report
// never duplicates). ~5 rows per pageload, capped by the route's per-user
// rate limit; scratch-cleanable via db:reset.
model RumEvent {
  id             String   @id @default(cuid())
  userId         String
  metric         String // TTFB | FCP | LCP | CLS | INP
  value          Float // ms (CLS is unitless)
  rating         String // good | needs-improvement | poor
  navigationType String   @default("navigate")
  path           String   @default("") // SPA path at report time (bounded 200)
  sessionId      String   @default("") // one per pageload (crypto UUID)
  userAgent      String   @default("") // bounded 300
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, metric])
  @@index([userId, createdAt])
}
