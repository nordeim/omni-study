// StudyFlow — Prisma schema (SQLite)
//
// DATABASE PATH CONTRACT (Prisma 6.19, verified empirically — see
// docs/Tailwind-V4-Validation-Report.md methodology + tests/db-path.test.ts):
//   • A url HARDCODED in the schema resolves relative to THIS FILE (prisma/).
//   • A SHELL-provided env("DATABASE_URL") relative `file:` URL ALSO anchors
//     at this schema file → "file:../db/custom.db" = <repo>/db/custom.db.
//   • An env var loaded from an .env FILE by the CLI anchors at the CWD
//     instead — which is why the `db:*` npm scripts set DATABASE_URL inline
//     (shell-provided, schema-anchored) rather than relying on auto-loading.
//   • The RUNTIME (next dev / build / standalone) reads .env's DATABASE_URL
//     through src/lib/db.ts, whose db-path.ts module re-resolves relative
//     `file:` URLs against the repo that owns this schema — one file,
//     <repo>/db/custom.db, for every entry point.
// The db/ folder lives at the repo root, git-ignored (recreate with
// `bun run db:push && bun run db:seed`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  avatarEmoji  String   @default("🎓")
  themeMode    String   @default("system") // light | dark | system
  accentColor  String   @default("violet") // violet|blue|green|orange|pink|red|teal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  subjects        Subject[]
  tasks           Task[]
  taskLists       TaskList[]
  assignments     Assignment[]
  exams           Exam[]
  events          Event[]
  timetableClass  TimetableClass[]
  notes           Note[]
  notebooks       Notebook[]
  decks           FlashcardDeck[]
  practiceTests   PracticeTest[]
  studyGroups     StudyGroup[]
  grades          Grade[]
  focusSessions   FocusSession[]
  folders         FileFolder[]
  files           FileItem[]
  chatMessages    AiChatMessage[]
  calcHistory     CalculatorHistoryEntry[]
  holidays        Holiday[]
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  teacher   String   @default("")
  room      String   @default("")
  createdAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  assignments    Assignment[]
  exams          Exam[]
  timetableClass TimetableClass[]
  decks          FlashcardDeck[]
  practiceTests  PracticeTest[]
  studyGroups    StudyGroup[]
  grades         Grade[]
  focusSessions  FocusSession[]
}

model TaskList {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
}

model Task {
  id         String    @id @default(cuid())
  userId     String
  title      String
  notes      String    @default("")
  completed  Boolean   @default(false)
  important  Boolean   @default(false)
  dueDate    DateTime?
  listId     String?
  subjectId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list    TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  subject Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, completed])
  @@index([userId, dueDate])
}

model Assignment {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String    @default("")
  subjectId   String?
  dueDate     DateTime?
  status      String    @default("active") // active | submitted | graded
  priority    String    @default("medium") // low | medium | high
  score       Float?
  maxScore    Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
}

model Exam {
  id        String    @id @default(cuid())
  userId    String
  title     String
  subjectId String?
  date      DateTime
  endTime   DateTime?
  location  String    @default("")
  notes     String    @default("")
  status    String    @default("upcoming") // upcoming | done
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String   @default("")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#8b5cf6")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model TimetableClass {
  id        String   @id @default(cuid())
  userId    String
  subjectId String?
  name      String
  dayOfWeek Int // 0 = Monday … 6 = Sunday (ISO weekday - 1)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  room      String   @default("")
  teacher   String   @default("")
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, dayOfWeek])
}

model Notebook {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  notebookId String?
  title      String   @default("Untitled")
  content    String   @default("")
  tags       String   @default("") // comma-separated
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
}

model FlashcardDeck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @default("")
  subjectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  cards   Flashcard[]
}

model Flashcard {
  id        String   @id @default(cuid())
  deckId    String
  front     String
  back      String
  mastered  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  deck FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

model PracticeTest {
  id              String    @id @default(cuid())
  userId          String
  title           String
  subjectId       String?
  date            DateTime?
  status          String    @default("created") // created | in_progress | completed
  score           Float?
  totalQuestions  Int       @default(0)
  correctCount    Int       @default(0)
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model StudyGroup {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String    @default("")
  subjectId   String?
  color       String    @default("#8b5cf6")
  members     String    @default("[]") // JSON array [{name, email}]
  nextMeeting DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model Grade {
  id         String   @id @default(cuid())
  userId     String
  subjectId  String?
  assessment String
  score      Float
  maxScore   Float    @default(100)
  weight     Float    @default(1)
  type       String   @default("assignment") // assignment | exam | quiz | project
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model FocusSession {
  id              String   @id @default(cuid())
  userId          String
  subjectId       String?
  date            DateTime @default(now())
  durationMinutes Int
  mode            String   @default("focus") // focus | short_break | long_break
  completed       Boolean  @default(true)
  createdAt       DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

model FileFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    FileItem[]
}

model FileItem {
  id        String   @id @default(cuid())
  userId    String
  folderId  String?
  name      String
  mimeType  String   @default("application/octet-stream")
  size      Int      @default(0)
  data      String? // base64 payload for small files (<= 2 MiB), null for links
  url       String   @default("") // external link (link-files)
  createdAt DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder FileFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([userId, folderId])
}

model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CalculatorHistoryEntry {
  id         String   @id @default(cuid())
  userId     String
  expression String
  result     String
  mode       String   @default("basic") // basic | scientific | gpa | converter
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Holiday {
  id        String   @id @default(cuid())
  userId    String
  name      String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
